diff --git a/AndroidManifest.xml b/AndroidManifest.xml
index fb2798ca620..d57895edbf3 100644
--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -6385,6 +6385,44 @@
             </intent-filter>
         </activity>
 
+        <!-- Locale Picker -->
+        <activity
+            android:name="com.google.android.settings.localepicker.SetupSystemLocalePickerActivity"
+            android:exported="true"
+            android:excludeFromRecents="true"
+            android:launchMode="singleTask">
+            <intent-filter android:priority="1">
+                <action android:name="com.google.android.settings.localepicker.LOCALE_REGION_PICKER"/>
+                <category android:name="android.intent.category.DEFAULT"/>
+            </intent-filter>
+        </activity>
+
+        <activity
+            android:name="com.google.android.settings.localepicker.SetupRegionAndNumberingSystemActivity"
+            android:exported="false">
+            <intent-filter>
+                <action android:name="com.google.android.settings.localepicker.REGIONAND_PICKER"/>
+                <category android:name="android.intent.category.DEFAULT"/>
+            </intent-filter>
+        </activity>
+
+        <activity
+            android:name="com.google.android.settings.localepicker.SetupRegionSearchActivity"
+            android:exported="false">
+            <intent-filter>
+                <action android:name="com.google.android.settings.localepicker.SETUP_REGION_SEARCH"/>
+                <category android:name="android.intent.category.DEFAULT"/>
+            </intent-filter>
+        </activity>
+
+        <receiver
+            android:name="com.google.android.settings.localepicker.LocalePickerSetupWizardEventsReceiver"
+            android:exported="true">
+            <intent-filter>
+                <action android:name="com.google.android.setupwizard.SETUP_WIZARD_FINISHED"/>
+            </intent-filter>
+        </receiver>
+
         <!-- This is the longest AndroidManifest.xml ever. -->
 
     </application>
