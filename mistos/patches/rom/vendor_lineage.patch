diff --git a/config/mist.mk b/config/mist.mk
index 66401fe..e1621ee 100644
--- a/config/mist.mk
+++ b/config/mist.mk
@@ -66,6 +66,21 @@ ifeq ($(TARGET_BUILD_DEVICE_AS_WEBCAM), true)
 endif
 
 # Face Unlock
+# shiba/husky ship a real Google/Pixel Class-3 face HAL (vendor/google/shiba
+# + vendor/google/faceunlock) -- confirmed on-device that shipping this
+# generic co.aospa.sense (Megvii SDK) implementation alongside it causes the
+# patched FaceService to register SenseProvider as THE face provider and
+# never even query the real HAL (ro.face.sense_service=true is what makes
+# it do that), plus a static/immutable RRO from this package
+# (FaceUnlockOverlay, pulled in via this module's own `required` list)
+# permanently hijacks Settings' config_face_enroll back to Sense's
+# enrollment activity. Gated on TARGET_PRODUCT specifically because it's
+# the one variable guaranteed set before any product makefile is even
+# read -- a same-file PRODUCT_PACKAGES/PRODUCT_SYSTEM_EXT_PROPERTIES
+# override in a later-inherited device product makefile was tried first
+# and did NOT work (something in the inherit chain processes this file's
+# additions later than that override point).
+ifeq ($(filter mist_shiba mist_husky,$(TARGET_PRODUCT)),)
 ifeq ($(TARGET_SUPPORTS_64_BIT_APPS),true)
 PRODUCT_PACKAGES += \
     FaceUnlock
@@ -76,6 +91,7 @@ PRODUCT_SYSTEM_EXT_PROPERTIES += \
 PRODUCT_COPY_FILES += \
     frameworks/native/data/etc/android.hardware.biometrics.face.xml:$(TARGET_COPY_OUT_SYSTEM_EXT)/etc/permissions/android.hardware.biometrics.face.xml
 endif
+endif
 
 # Use a generic profile based boot image by default
 PRODUCT_USE_PROFILE_FOR_BOOT_IMAGE := true
