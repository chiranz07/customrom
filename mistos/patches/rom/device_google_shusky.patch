diff --git a/sepolicy/vendor/gpuflag.te b/sepolicy/vendor/gpuflag.te
new file mode 100644
index 0000000..66bea4d
--- /dev/null
+++ b/sepolicy/vendor/gpuflag.te
@@ -0,0 +1,25 @@
+# /vendor/bin/gpuflag ships in TheMuppets' real vendor blobs (both shiba
+# and husky) with its own /vendor/etc/init/gpuflag.rc
+# (exec_background u:r:gpuflag:s0 -- /vendor/bin/gpuflag), but no matching
+# sepolicy domain exists anywhere in this device tree -- confirmed via
+# on-device logcat: setexeccon('u:r:gpuflag:s0') fails outright with
+# EINVAL every boot (the type is simply undefined), so GPU feature flags
+# never get applied. ionutsandroidbuilds' zuma tree never ported the real
+# Pixel sepolicy for this binary. Minimal domain to get it running --
+# extend based on any further denials that show up in logs once this is
+# in place, same as was done for trusty_apploader/hal_face_default.
+
+type gpuflag, domain;
+type gpuflag_exec, exec_type, file_type, vendor_file_type;
+
+init_daemon_domain(gpuflag)
+
+# Verified on-device 2026-09-17: with this domain the binary now starts
+# (no more setexeccon EINVAL every boot) and exits 1 after 36ms with NO avc
+# denials. That exit is the binary's own "unsupported device" path: the
+# only sysfs node it knows is /sys/devices/genpd:0:34f00000.gpu0/power/
+# autosuspend_delay_ms, which does not exist on shiba (zuma's Mali is at
+# 1f000000; 34f00000 appears nowhere in the zuma kernel sources), and the
+# same binary ships unchanged in the husky blobs. It is a shared gs-family
+# tool aimed at a newer SoC; exiting 1 on zuma is stock behavior. Nothing
+# more to grant here.
diff --git a/sepolicy/vendor/hal_face_default_extra.te b/sepolicy/vendor/hal_face_default_extra.te
new file mode 100644
index 0000000..763fb31
--- /dev/null
+++ b/sepolicy/vendor/hal_face_default_extra.te
@@ -0,0 +1,21 @@
+# Confirmed via on-device logcat (userdebug avc denials at boot, right after
+# the face TA successfully loads via trusty_apploader -- that part already
+# works fine, these are the actual blockers):
+#
+#   avc: denied { read } for comm="android.hardwar" name="u:object_r:default_prop:s0" \
+#       scontext=u:r:hal_face_default:s0 tcontext=u:object_r:default_prop:s0 tclass=file \
+#       permissive=0 bug=b/487141902
+#   avc: denied { read } for comm="android.hardwar" name="/" dev="sda10" ino=3 \
+#       scontext=u:r:hal_face_default:s0 tcontext=u:object_r:metadata_file:s0 tclass=dir \
+#       permissive=0
+#
+# Either denial failing an init check is consistent with the HAL reporting
+# itself unavailable and the framework falling back to generic face auth.
+
+# get_prop(hal_face_default, default_prop) -- REVERTED: violates a hard
+# AOSP neverallow (system/sepolicy/{public,private}/property.te) that blocks
+# every domain from broadly reading the generic default_prop bucket. Need
+# the actual property name to give it its own dedicated context instead;
+# still figuring that out (property name not visible in the on-device
+# logcat capture we have so far, only its unlabeled fallback context).
+allow hal_face_default metadata_file:dir r_dir_perms;
diff --git a/sepolicy/vendor/sysfs_hbm.te b/sepolicy/vendor/sysfs_hbm.te
new file mode 100644
index 0000000..2f45ec9
--- /dev/null
+++ b/sepolicy/vendor/sysfs_hbm.te
@@ -0,0 +1,13 @@
+# Auto HBM (device/google/zuma/parts, package org.lineageos.settings, runs as
+# system_app via android.uid.system). The Samsung panel driver exposes the
+# high-brightness-mode knob at
+#   /sys/class/backlight/panel0-backlight/hbm_mode
+# (-> /sys/devices/platform/19440000.drmdsim/19440000.drmdsim.0/backlight/
+#     panel0-backlight/hbm_mode). zuma labels the whole backlight dir
+# sysfs_leds, which system_app can neither search nor write, so the single
+# node gets its own type (genfs_contexts in this directory) and system_app
+# is allowed through to it.
+type sysfs_hbm, sysfs_type, fs_type;
+
+allow system_app sysfs_leds:dir search;
+allow system_app sysfs_hbm:file rw_file_perms;
diff --git a/sepolicy/vendor/trusty_apploader_faceauth.te b/sepolicy/vendor/trusty_apploader_faceauth.te
new file mode 100644
index 0000000..3061254
--- /dev/null
+++ b/sepolicy/vendor/trusty_apploader_faceauth.te
@@ -0,0 +1,14 @@
+# The real Pixel face-auth Trusty Application ships inside a vendor APEX
+# (com.google.android.hardware.biometrics.face) and gets loaded at boot via
+# `exec_background - system shell -- /vendor/bin/trusty_apploader
+# /apex/.../etc/firmware/faceauth.app` (ta_init.rc, bundled in the apex
+# itself). zuma's trusty_apploader.te only grants access to two device
+# nodes (dmabuf_system_heap_device, tee_device) -- no permission at all to
+# read the actual TA file it's told to load, which lives under a vendor
+# APEX mount. Without this, the TA never loads, the framework falls back
+# to generic/insecure face auth, and no error surfaces anywhere except a
+# silent SELinux denial in the log.
+
+allow trusty_apploader apex_mnt_dir:dir { search getattr };
+allow trusty_apploader vendor_apex_file:dir { search getattr };
+allow trusty_apploader vendor_apex_file:file r_file_perms;
