diff --git a/product/blobs/etc/sysconfig/pixel_experience_2017.xml b/product/blobs/etc/sysconfig/pixel_experience_2017.xml
index 9ee04d2..fc5e75f 100644
--- a/product/blobs/etc/sysconfig/pixel_experience_2017.xml
+++ b/product/blobs/etc/sysconfig/pixel_experience_2017.xml
@@ -42,12 +42,26 @@
     <allow-in-power-save package="com.google.pixel.gate.android.pysupport" />
     <allow-in-power-save package="com.google.pixel.gate.android.daemon" />
 
-    <!-- Hide DocumentsUi Launcher/Downloads intent handling. DocumentsUi
-         PrebootReceiver does not properly hide the launcher in work profile,
-         so we need to include this as well. -->
+    <!-- Real root cause, found by decompiling DocumentsUIGoogle.apk directly:
+         com.android.documentsui.PreBootReceiver (PRE_BOOT_COMPLETED) is real
+         Google code that actively calls setComponentEnabledSetting() on its
+         own LauncherActivity/ViewDownloadsActivity at boot; this is why
+         two earlier attempts (inverting this override to enabled="true", and
+         removing it outright) both failed on a genuinely fresh /data-wiped
+         boot: neither one touches the actual mechanism doing the disabling.
+         The manifest itself declares no android:enabled attribute on the
+         alias (confirmed via aapt2 dump), so the disable is 100% runtime
+         code, not a static manifest/config default. mist_shiba never
+         inherits gms_full.mk (TARGET_USES_MINI_GAPPS is hardcoded true), so
+         FilesPrebuilt is never present, meaning Google's own intended
+         behavior (hide this in favor of Files by Google) leaves us with no
+         file manager icon at all. Fix: disable PreBootReceiver itself so its
+         disabling code never runs, plus keep the launcher components
+         explicitly enabled as a belt-and-suspenders measure. -->
     <component-override package="com.google.android.documentsui" >
-        <component class="com.android.documentsui.LauncherActivity" enabled="false" />
-        <component class="com.android.documentsui.ViewDownloadsActivity" enabled="false" />
+        <component class="com.android.documentsui.PreBootReceiver" enabled="false" />
+        <component class="com.android.documentsui.LauncherActivity" enabled="true" />
+        <component class="com.android.documentsui.ViewDownloadsActivity" enabled="true" />
     </component-override>
 
     <!-- ACTION_MANAGE_STORAGE handled by Files by Google -->
