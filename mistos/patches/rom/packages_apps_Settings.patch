+    /** Intent for the wallpaper & style app, or null when it can't be resolved. */
+    private Intent buildWallpaperPickerIntent() {
+        final String pkg = mContext.getString(R.string.config_wallpaper_picker_package);
+        if (TextUtils.isEmpty(pkg)) {
+            return null;
+        }
+        String cls = mContext.getString(R.string.config_styles_and_wallpaper_picker_class);
+        if (TextUtils.isEmpty(cls) || !canResolve(pkg, cls)) {
+            cls = mContext.getString(R.string.config_wallpaper_picker_class);
+        }
+        if (TextUtils.isEmpty(cls) || !canResolve(pkg, cls)) {
+            return null;
+        }
+        return new Intent()
+                .setComponent(new ComponentName(pkg, cls))
+                .putExtra(mContext.getString(R.string.config_wallpaper_picker_launch_extra),
+                        "app_launched_settings")
+                .setFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+    }
+
+    private boolean canResolve(String pkg, String cls) {
+        final PackageManager pm = mContext.getPackageManager();
+        final Intent intent = new Intent().setComponent(new ComponentName(pkg, cls));
+        final List<ResolveInfo> infos = pm.queryIntentActivities(intent, 0 /* flags */);
+        return infos != null && !infos.isEmpty();
+    }
+
     private void disablePreferenceIfManaged(RestrictedTopLevelPreference pref) {
