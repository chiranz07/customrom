-    <hal format="aidl">
-        <name>android.hardware.security.keymint</name>
-        <version>3</version>
-        <fqname>IRemotelyProvisionedComponent/strongbox</fqname>
-    </hal>
+    <!-- IRemotelyProvisionedComponent/strongbox was declared here but never
+         backed by any implementation: the actual citadel keymint blob's own
+         VINTF fragment (vendor/google/shiba/proprietary/vendor/etc/vintf/
+         manifest/android.hardware.security.keymint-service-v3.citadel.xml,
+         extracted straight from Google's real proprietary blob) only
+         declares IKeyMintDevice/strongbox, never the RKP component.
+         servicemanager tried to lazy-start it forever (246 retries/46min
+         uptime observed on-device), permanently blocking rkpdapp and
+         mediaserver. Confirmed via live `service list` that only
+         IRemotelyProvisionedComponent/default is actually registered.
+         The framework compatibility matrix lists "strongbox" as an
+         allowed instance, not a mandatory one (most Android devices have
+         no discrete secure element at all), so removing this stray
+         declaration doesn't violate VINTF compatibility. -->
     <hal format="aidl">
         <name>com.google.input</name>
         <version>8</version>
