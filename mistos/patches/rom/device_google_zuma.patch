diff --git a/sepolicy/vendor/property_contexts b/sepolicy/vendor/property_contexts
index 9c942a1..f0b504f 100644
--- a/sepolicy/vendor/property_contexts
+++ b/sepolicy/vendor/property_contexts
@@ -5,6 +5,18 @@ persist.vendor.camera. u:object_r:vendor_camera_prop:s0
 persist.vendor.camera.pbcs.debug. u:object_r:vendor_camera_pbcs_debug_prop:s0
 persist.vendor.cbd. u:object_r:vendor_cbd_prop:s0
 persist.vendor.config. u:object_r:vendor_persist_config_default_prop:s0
+# NOTE: telephony.ril.modem_bin_status (set by cbd.rc, a real vendor blob
+# file) is NOT vendor-namespaced, so it can't be labeled here at all --
+# Android's VTS-enforced property namespace check (check_prop_prefix)
+# rejects any vendor property_contexts entry for a non-"vendor."-prefixed
+# property outright, regardless of what type it's given. Confirmed via a
+# real build failure trying exactly that. Fixing this properly would need
+# either BUILD_BROKEN_VENDOR_PROPERTY_NAMESPACE := true (too broad -- weakens
+# VTS compliance for every vendor property, not just this one) or patching
+# cbd.rc itself to target a vendor-prefixed property name instead (risky --
+# other unknown components may read this exact literal name). Left as a
+# known, non-fatal denial (vendor_init can't set it, low-impact: it just
+# tracks which of two modem firmware binary variants is active).
 persist.vendor.display. u:object_r:vendor_display_prop:s0
 persist.vendor.fingerprint. u:object_r:vendor_fingerprint_prop:s0
 persist.vendor.gps. u:object_r:vendor_gps_prop:s0
diff --git a/vendor.prop b/vendor.prop
index 7cdadaf..c1cf5d6 100644
--- a/vendor.prop
+++ b/vendor.prop
@@ -112,8 +112,12 @@ vendor.media.omx=0
 vendor.powerhal.apf_disabled=false
 vendor.powerhal.apf_enabled=true
 
-# Rescue party
-persist.device_config.configuration.disable_rescue_party=true
+# NOTE: "Rescue party" disable removed -- persist.device_config.* properties
+# can't be set from vendor.prop at all (vendor_init has no write access to
+# device_config_configuration_prop by design; confirmed via on-device boot
+# denial). This line never actually took effect. Setting this for real
+# would need a DeviceConfig.setProperty() call at runtime, not a static
+# vendor prop file.
 
 # SoC
 ro.soc.manufacturer=Google
