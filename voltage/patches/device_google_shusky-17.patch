diff --git a/sepolicy/vendor/hal_face_default_extra.te b/sepolicy/vendor/hal_face_default_extra.te
new file mode 100644
index 0000000..eb626b2
--- /dev/null
+++ b/sepolicy/vendor/hal_face_default_extra.te
@@ -0,0 +1,3 @@
+# Real Google face HAL reads the metadata partition root at init; denied at boot
+# (avc: denied { read } hal_face_default -> metadata_file:dir). Same fix as Mist-OS.
+allow hal_face_default metadata_file:dir r_dir_perms;
diff --git a/voltage_husky.mk b/voltage_husky.mk
new file mode 100644
index 0000000..1b3762c
--- /dev/null
+++ b/voltage_husky.mk
@@ -0,0 +1,59 @@
+#
+# SPDX-FileCopyrightText: The LineageOS Project
+# SPDX-FileCopyrightText: The Calyx Institute
+# SPDX-License-Identifier: Apache-2.0
+#
+
+# Inherit some common stuff
+$(call inherit-product, vendor/voltage/config/common_full_phone.mk)
+
+# Inherit device configuration
+DEVICE_CODENAME := husky
+DEVICE_PATH := device/google/shusky
+VENDOR_PATH := vendor/google/husky
+$(call inherit-product, $(DEVICE_PATH)/aosp_$(DEVICE_CODENAME).mk)
+
+# Device identifier. This must come after all inclusions
+PRODUCT_NAME := voltage_$(DEVICE_CODENAME)
+PRODUCT_SYSTEM_BRAND := google
+PRODUCT_SYSTEM_MANUFACTURER := Google
+PRODUCT_SYSTEM_NAME := generic_system_google
+
+# Boot animation
+TARGET_SCREEN_HEIGHT := 2992
+TARGET_SCREEN_WIDTH := 1344
+
+PRODUCT_BUILD_PROP_OVERRIDES += \
+    BuildDesc="husky-user 17 CP2A.260805.005 15828068 release-keys" \
+    BuildFingerprint=google/husky/husky:17/CP2A.260805.005/15828068:user/release-keys \
+    BuildSystemFingerprint=google/generic_system_google/generic:17/CP2A.260805.005/15828068:user/release-keys \
+    DeviceProduct=$(DEVICE_CODENAME)
+
+$(call inherit-product, $(VENDOR_PATH)/$(DEVICE_CODENAME)-vendor.mk)
+
+# VoltageOS additions (Pixel 8 family on LineageOS lineage-24.0 trees)
+TARGET_BOOT_ANIMATION_RES := $(TARGET_SCREEN_WIDTH)
+# generic_system.mk GSI artifact-path check: allow Google/vendor bits that land in bare system/
+PRODUCT_ARTIFACT_PATH_REQUIREMENT_ALLOWED_LIST += \
+    system/apex/% system/app/% system/priv-app/% system/lib/% system/lib64/% system/etc/% \
+    system/framework/% system/bin/% system/fonts/% system/media/% system/usr/%
+
+# Real Goodix fingerprint HAL runs, but this device tree never declares the
+# android.hardware.fingerprint feature -> SystemServer never starts FingerprintService
+# ("AuthService: Fingerprint configuration exists, but FingerprintService is null")
+# and Settings hides fingerprint entirely. Same fix as Mist-OS (FEATURES.md #3).
+PRODUCT_PACKAGES += \
+    android.hardware.fingerprint.prebuilt.xml
+
+# Real Google Class-3 face unlock comes from the vendor face HAL apex in the blobs.
+# Voltage's bundled Megvii/Sense FaceUnlock registers a software provider first and the
+# framework then never constructs the real FaceProvider (same root cause as Mist-OS
+# FEATURES.md section 2). Set here rather than in vendor/voltage/config/common.mk because the
+# product makefile is parsed before the parent's `?=`, so this wins.
+TARGET_FACE_UNLOCK_SUPPORTED := false
+
+# ...but keep the face feature XML that the same upstream block would have copied, or
+# Settings hides face unlock entirely.
+PRODUCT_COPY_FILES += \
+    frameworks/native/data/etc/android.hardware.biometrics.face.xml:$(TARGET_COPY_OUT_SYSTEM)/etc/permissions/android.hardware.biometrics.face.xml
+
